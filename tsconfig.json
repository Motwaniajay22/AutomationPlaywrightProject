{
    "compilerOptions": {

        "target": "ES2024",

        "module": "commonjs",

        "moduleResolution": "node",

        "types": ["node", "@playwright/test"],

        "strict": true,

        "strictNullChecks": true,

        "strictFunctionTypes": true,

        "sourceMap": true,

        "esModuleInterop": true,

        "resolveJsonModule": true,

        "skipLibCheck": true
    },

    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}